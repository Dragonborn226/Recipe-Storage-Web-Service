# Copy this file to ".env" and paste your Atlas connection string below.
# Atlas: Database > Connect > Drivers > copy the string, replace <password>,
# and add a database name after the host (e.g. /recipeApp).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/recipeApp?retryWrites=true&w=majority
PORT=3000
